#!/usr/bin/env python3
"""
OASIS SOVEREIGN OS — MONITOR DE MALLA DINÁMICO (PILAR 371)
Muestra los nodos reales conectados sin simulaciones estáticas.
"""
import json
import subprocess

try:
    raw = subprocess.check_output(["python3", "agents_core/oasis_swarm_orchestrator.py"], text=True)
    data = json.loads(raw)
except Exception as e:
    print(f"❌ Error leyendo telemetría de malla: {e}")
    exit(1)

print("════════════════════════════════════════════════════════════════")
print(f"🌐 MALLA PLANETARIA OASIS — NODOS REALES: {data['active_nodes']} | {data['collective_compute_tflops']} TFLOPS")
print(f"⚡ POTENCIA AGREGADA VIVA : {data['collective_power_w']} W (PROMEDIO: {data['average_power_per_node_w']} W/NODO)")
print(f"📐 EFICIENCIA TRANSFER    : {data['chen_panzano_ratio']}")
print("────────────────────────────────────────────────────────────────")
print(f"{'NODE_ID':<22} {'ROL EN MODELO':<24} {'ARQUITECTURA':<20} {'ESTADO'}")
print("────────────────────────────────────────────────────────────────")
for n in data["nodes"]:
    print(f"{n.get('id', 'N/A'):<22} {n.get('role', 'Worker'):<24} {n.get('arch', 'WebGPU'):<20} {n.get('status', 'ONLINE')}")
print("════════════════════════════════════════════════════════════════")
