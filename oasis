#!/usr/bin/env bash
HOST="http://127.0.0.1:8080"
CMD="$1"
shift

case "$CMD" in
  lean|verify-lean)
    echo "⚛️ [AUDITORÍA FORMAL LEAN 4 EN VIVO]:"
    curl -s "$HOST/v1/math/lean-audit" | python3 -c '
import sys, json
d = json.load(sys.stdin)
kernel = d.get("kernel", "Lean 4")
status = d.get("status", "CERTIFIED")
sorry = d.get("sorry_count", 0)
print(f" Kernel: {kernel} | Estado: {status} (sorry={sorry})")
print("-" * 65)
for t in d.get("theorems", []):
    print("  ✅ " + str(t))
print("-" * 65)
print(" Teoremas certificados matemáticamente sin margen de alucinación.")
'
    ;;
  pilar|seal-pilar)
    PILAR_ID="$1"
    TITLE="$2"
    CONTENT="$3"
    if [ -z "$PILAR_ID" ] || [ -z "$TITLE" ] || [ -z "$CONTENT" ]; then
      echo "Uso: ./oasis pilar <número> \"Título\" \"Contenido\""
      exit 1
    fi
    curl -s -X POST "$HOST/v1/vault/save-pilar" \
      -H "Content-Type: application/json" \
      -d "{\"pilar_id\":$PILAR_ID, \"title\":\"$TITLE\", \"content\":\"$CONTENT\"}" | python3 -m json.tool
    ;;
  ai|chat)
    PROMPT="$*"
    curl -s -X POST "$HOST/v1/ai/chat" -H "Content-Type: application/json" -d "{\"prompt\":\"$PROMPT\"}" | python3 -c '
import sys, json
d = json.load(sys.stdin)
print(d.get("reply", ""))
'
    ;;
  send|inbox)
    curl -s -X POST "$HOST/v1/vault/inbox" -H "Content-Type: application/json" -d "{\"subject\":\"$1\",\"body\":\"$2\"}" | python3 -m json.tool
    ;;
  plot)
    curl -s "$HOST/v1/med/slice-axial" | python3 -c '
import sys, json
d = json.load(sys.stdin)
peak = d.get("tawss_peak_pa")
z_sten = d.get("stenosis_z_mm")
print(f"📊 Pico TAWSS: {peak} Pa (Z={z_sten} mm)")
print("-" * 65)
for z, t in zip(d.get("z_axis_mm", [])[::2], d.get("tawss_curve_pa", [])[::2]):
    print(f" Z={z:>2} mm | {t:>5.2f} Pa | " + "█" * int(t * 3.5))
'
    ;;
  slice)
    curl -s "$HOST/v1/med/slice-axial" | python3 -c '
import sys, json, math
d = json.load(sys.stdin)
radii = d.get("lumen_radius_mm", [])
print(f"🩺 Constricción radial: {min(radii)} mm a {max(radii)} mm")
grid = [[" " for _ in range(13)] for _ in range(13)]
for idx, r in enumerate(radii):
    th = idx * (math.pi / 8)
    px = int(6 + r * 3.2 * math.cos(th))
    py = int(6 + r * 1.8 * math.sin(th))
    if 0 <= px < 13 and 0 <= py < 13: grid[py][px] = "•"
grid[6][6] = "+"
for row in grid: print("  " + "".join(row))
'
    ;;
  vault)  curl -s "$HOST/v1/vault/list" | python3 -m json.tool ;;
  status) curl -s "$HOST/v1/system/audit-report" | python3 -m json.tool ;;
  *)
    echo "Uso: ./oasis [lean | pilar <id> <titulo> <texto> | ai <pregunta> | send <asunto> <texto> | plot | slice | vault]"
    ;;
esac
