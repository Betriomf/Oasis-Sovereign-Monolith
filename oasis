#!/usr/bin/env bash
HOST="http://127.0.0.1:8080"
CMD="$1"
shift

case "$CMD" in
  code|edit)
    FNAME="$1"
    if [ -z "$FNAME" ]; then
      echo "Abriendo directorio de la Bóveda en VS Code..."
      code ~/Oasis-Sovereign-Monolith/vault
    else
      echo "Abriendo $FNAME en VS Code..."
      code ~/Oasis-Sovereign-Monolith/vault/"$FNAME"
    fi
    ;;
  soap)
    FNAME="${1:-INFORME_CLINICO_CAROTIDA_SHA256.md}"
    curl -s -X POST "$HOST/v1/med/soap" -H "Content-Type: application/json" -d "{\"file\":\"$FNAME\"}" | python3 -c '
import sys, json
d = json.load(sys.stdin)
s = d.get("soap", {})
print("📋 Dataset SOAP generado:", d.get("dataset_file"))
print(" [S] SUBJETIVO :", s.get("subjective", {}).get("anamnesis", ""))
print(" [O] OBJETIVO  : TAWSS =", s.get("objective", {}).get("tawss_peak_pa"), "Pa")
print(" [A] EVALUACIÓN:", s.get("assessment", {}).get("diagnostic", ""))
print(" [P] PLAN      :", s.get("plan", {}).get("surgical", ""))
'
    ;;
  vault)
    curl -s "$HOST/v1/vault/inspect" | python3 -c '
import sys, json
d = json.load(sys.stdin)
print(f"📁 Total archivos: {d.get(\"total_files\", 0)} en {d.get(\"path\", \"\")}")
print("-" * 70)
for f in d.get("files", []):
    print(f" 📄 {f.get(\"name\", \"\").ljust(35)} | {str(f.get(\"size_bytes\", 0)).rjust(7)} B")
print("-" * 70)
'
    ;;
  read|cat)
    curl -s -X POST "$HOST/v1/darwin/exec" -H "Content-Type: application/json" -d "{\"command\":\"cat vault/$1\"}" | python3 -c '
import sys, json
print(json.load(sys.stdin).get("output", "No encontrado"))
'
    ;;
  ai)
    curl -s -X POST "$HOST/v1/ai/chat" -H "Content-Type: application/json" -d "{\"prompt\":\"$*\"}" | python3 -c '
import sys, json
print(json.load(sys.stdin).get("reply", ""))
'
    ;;
  lean)
    curl -s "$HOST/v1/math/lean-audit" | python3 -c '
import sys, json
d = json.load(sys.stdin)
print(f"⚛️ Kernel: {d.get(\"kernel\")} | Estado: {d.get(\"status\")} (sorry={d.get(\"sorry_count\")})")
for t in d.get("theorems", []): print("  ✅ " + str(t))
'
    ;;
  plot)
    curl -s "$HOST/v1/med/slice-axial" | python3 -c '
import sys, json
d = json.load(sys.stdin)
print(f"📊 Pico TAWSS: {d.get(\"tawss_peak_pa\")} Pa (Z={d.get(\"stenosis_z_mm\")} mm)")
for z, t in zip(d.get("z_axis_mm", [])[::2], d.get("tawss_curve_pa", [])[::2]):
    print(f" Z={z:>2} mm | {t:>5.2f} Pa | " + "█" * int(t * 3.5))
'
    ;;
  *)
    echo "OASIS CLI DISPONIBLE:"
    echo "  • ./oasis code [archivo]   -> Abrir archivo o bóveda en VS Code nativo"
    echo "  • ./oasis soap [archivo]   -> Compilar dataset clínico SOAP"
    echo "  • ./oasis vault            -> Inspeccionar archivos en disco"
    echo "  • ./oasis read <archivo>   -> Leer archivo de bóveda"
    echo "  • ./oasis ai <pregunta>    -> Consultar a la IA"
    echo "  • ./oasis lean             -> Certificación formal Lean 4"
    echo "  • ./oasis plot             -> Curva axial TAWSS"
    ;;
esac
