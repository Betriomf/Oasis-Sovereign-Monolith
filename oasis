#!/usr/bin/env bash
HOST="http://127.0.0.1:8080"
CMD="$1"
shift

case "$CMD" in
  ai|chat)
    PROMPT="$*"
    if [ -z "$PROMPT" ]; then
      echo "Uso: ./oasis ai <pregunta sobre pilares o sobre tus archivos de bóveda>"
      exit 1
    fi
    curl -s -X POST "$HOST/v1/ai/chat" -H "Content-Type: application/json" -d "{\"prompt\":\"$PROMPT\"}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('reply',''))"
    ;;
  send|inbox)
    SUBJECT="$1"
    BODY="$2"
    if [ -z "$SUBJECT" ] || [ -z "$BODY" ]; then
      echo "Uso: ./oasis send \"Asunto\" \"Texto que te envías a ti mismo\""
      exit 1
    fi
    curl -s -X POST "$HOST/v1/vault/inbox" -H "Content-Type: application/json" -d "{\"subject\":\"$SUBJECT\",\"body\":\"$BODY\"}" | python3 -m json.tool
    ;;
  demon|landauer) curl -s "$HOST/v1/math/demon" | python3 -m json.tool ;;
  hemo|besov)     curl -s "$HOST/v1/med/besov-cfd" | python3 -m json.tool ;;
  mesh|geometry)  curl -s "$HOST/v1/med/mesh-geometry" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'Nodos: {d[\"num_nodes\"]}, Triángulos: {d[\"num_triangles\"]}, Archivo: {d[\"file\"]}')" ;;
  riemann)        curl -s "$HOST/v1/math/riemann" | python3 -m json.tool ;;
  swarm|nodes)    curl -s "$HOST/v1/swarm/nodes" | python3 -m json.tool ;;
  vault|files)    curl -s "$HOST/v1/vault/list" | python3 -m json.tool ;;
  status|audit)   curl -s "$HOST/v1/system/audit-report" | python3 -m json.tool ;;
  *)
    echo "OASIS SOVEREIGN CLI — COMANDOS DISPONIBLES:"
    echo "  • ./oasis ai <pregunta>             -> Consulta RAG sobre Pilares y Bóveda"
    echo "  • ./oasis send <asunto> <texto>     -> Enviarte una nota/archivo a la Bóveda"
    echo "  • ./oasis vault                     -> Ver archivos guardados en disco"
    echo "  • ./oasis hemo | demon | riemann    -> Endpoints científicos de Capa 0"
    ;;
esac
