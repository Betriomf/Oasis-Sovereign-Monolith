#!/usr/bin/env bash
HOST="http://127.0.0.1:8080"
CMD="$1"
shift

case "$CMD" in
  history|historia|audit)
    echo "📜 [OASIS HISTORY — AUDITORÍA CRIPTOGRÁFICA INMUTABLE]:"
    curl -s "$HOST/v1/history/audit" | python3 -c '
import sys, json
raw = sys.stdin.read().strip()
if raw:
    d = json.loads(raw)
    print("• Investigador  :", d.get("lead_researcher"))
    print("• Hardware ID   :", d.get("hardware_id"))
    print("• 12 Palabras   :", d.get("mnemonic_12_words"))
    print("• Invariante    :", d.get("attractor_invariant"))
    print("• Cota Térmica  :", d.get("sub_landauer_limit"))
    print("-" * 65)
    print("⚛️ TEOREMAS FORMALES LEAN 4:")
    for t in d.get("lean4_theorems", []):
        print("  ✅", t)
    print("-" * 65)
    print("🔗 ÚLTIMOS COMMITS INMUTABLES:")
    for c in d.get("immutable_commits", []):
        print(" ", c)
'
    ;;
  plugin|plugins)
    SUB="$1"
    if [ "$SUB" = "toggle" ]; then
      PID="$2"
      curl -s -X POST "$HOST/v1/plugins/toggle" -H "Content-Type: application/json" -d "{\"id\":\"$PID\"}" > /dev/null
      echo "⚡ Estado de $PID conmutado en el Ledger local."
      "$0" plugin
    else
      echo "📦 [REGISTRO SOBERANO DE PLUGINS & NFTS]:"
      curl -s "$HOST/v1/plugins/list" | python3 -c '
import sys, json
raw = sys.stdin.read().strip()
if raw:
    items = json.loads(raw).get("plugins", [])
    print("-" * 74)
    for p in items:
        st = "🟢 ACTIVO" if p.get("enabled") else "⚪ INACTIVO"
        tier = str(p.get("tier", "FREE")).ljust(8)
        pr = (str(p.get("price_spn", 0.0)) + " $SPN").rjust(10)
        pid = str(p.get("id", "")).ljust(28)
        cid = str(p.get("ipfs_cid", ""))
        print(" " + st + " | " + pid + " | " + tier + " | " + pr)
        print("   └─ CID: ipfs://" + cid)
    print("-" * 74)
'
    fi
    ;;
  ai)
    curl -s -X POST "$HOST/v1/ai/chat" -H "Content-Type: application/json" -d "{\"prompt\":\"$*\"}" | python3 -c '
import sys, json
raw = sys.stdin.read().strip()
if raw:
    print(json.loads(raw).get("reply", "Sin respuesta."))
'
    ;;
  *)
    echo "OASIS CLI: [history | plugin | ai]"
    ;;
esac
