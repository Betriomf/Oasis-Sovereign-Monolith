#!/usr/bin/env bash
HOST="http://127.0.0.1:8080"
CMD="$1"
shift

case "$CMD" in
  plugin|plugins)
    SUB="$1"
    if [ "$SUB" = "toggle" ]; then
      PID="$2"
      curl -s -X POST "$HOST/v1/plugins/toggle" -H "Content-Type: application/json" -d "{\"id\":\"$PID\"}" > /dev/null
      echo "⚡ Estado de $PID conmutado en el Ledger local."
      "$0" plugin
    else
      echo "📦 [REGISTRO SOBERANO DE PLUGINS & NFTS]:"
      curl -s "$HOST/v1/plugins/list" | python3 -c '
import sys, json
raw = sys.stdin.read().strip()
if raw:
    try:
        items = json.loads(raw).get("plugins", [])
        print("-" * 74)
        for p in items:
            st = "🟢 ACTIVO" if p.get("enabled") else "⚪ INACTIVO"
            tier = str(p.get("tier", "FREE")).ljust(8)
            pr = (str(p.get("price_spn", 0.0)) + " $SPN").rjust(10)
            pid = str(p.get("id", "")).ljust(28)
            cid = str(p.get("ipfs_cid", ""))
            print(" " + st + " | " + pid + " | " + tier + " | " + pr)
            print("   └─ CID: ipfs://" + cid)
        print("-" * 74)
        print("Uso: ./oasis plugin toggle <id>  -> Conmutar estado")
    except Exception as e:
        print("Error analizando plugins:", e)
else:
    print("⚠️ El Gateway no devolvió datos.")
'
    fi
    ;;
  ai)
    curl -s -X POST "$HOST/v1/ai/chat" -H "Content-Type: application/json" -d "{\"prompt\":\"$*\"}" | python3 -c '
import sys, json
raw = sys.stdin.read().strip()
if raw:
    try:
        print(json.loads(raw).get("reply", "Sin respuesta."))
    except Exception:
        print(raw)
else:
    print("⚠️ El Gateway no devolvió datos.")
'
    ;;
  mesh|geometry)
    curl -s "$HOST/v1/med/mesh-geometry" | python3 -c '
import sys, json
raw = sys.stdin.read().strip()
if raw:
    try:
        d = json.loads(raw)
        print("🩺 Malla:", d.get("status"), "| Nodos:", d.get("num_nodes"), "| Triángulos:", d.get("num_triangles"))
    except Exception:
        print("Respuesta:", raw[:100])
else:
    print("⚠️ Error obteniendo geometría vascular.")
'
    ;;
  *)
    echo "OASIS CLI: [plugin | ai | mesh]"
    ;;
esac
