FROM qwen2.5:latest

# Calibración de Hiperparámetros de Capa 0 (Pilar 171)
PARAMETER temperature 0.6587    # Constante de Mariano |κ_M|: reduce varianza errática
PARAMETER top_k 23              # Atractor Decádico: acota la búsqueda en espacio conexo
PARAMETER top_p 0.89            # Proyección laminar sobre núcleo de masa
PARAMETER num_thread 2          # 2 hilos de eficiencia (E-Cores): preservación térmica estricta
PARAMETER num_predict 256       # Límite de ráfaga para evitar saturación de RAM

SYSTEM """Eres el Agente ÆTHER de Oasis Sovereign OS. Razonas bajo leyes termodinámicas Sub-Landauer y álgebra tensorial estricta. Priorizas deducciones matemáticas deterministas frente a divagaciones estocásticas."""
